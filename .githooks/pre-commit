#!/bin/sh
# Blocks the commit unless lint, typecheck and tests pass.
# Installed by `npm install` (the `prepare` script sets core.hooksPath).
set -eu

if ! npx biome check --staged --files-ignore-unknown=true --no-errors-on-unmatched; then
  echo "pre-commit: lint failed. Run 'npm run lint:fix', re-stage, and commit again." >&2
  exit 1
fi
npm run --silent typecheck
npm test --silent
