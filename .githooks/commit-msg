#!/bin/sh
# Rejects commit messages that aren't Conventional Commits (see CONTRIBUTING.md).
# Installed by `npm install` (the `prepare` script sets core.hooksPath).
set -eu

subject=$(grep -v '^#' "$1" | head -n 1)

# Messages git or a rebase writes itself.
case "$subject" in
  'Merge '* | 'Revert "'* | 'fixup! '* | 'squash! '* | 'amend! '*) exit 0 ;;
esac

types='feat|fix|perf|refactor|style|test|docs|build|ci|chore|revert'
if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9-]+\))?!?: [^ ].*"; then
  echo "commit-msg: not a Conventional Commit: \"$subject\"" >&2
  echo "  expected <type>(<scope>)!: <description>, type one of: $(echo "$types" | tr '|' ' ')" >&2
  echo "  see CONTRIBUTING.md" >&2
  exit 1
fi
